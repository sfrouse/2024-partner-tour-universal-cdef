{
  "name": "2024-partner-tour-demo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
},
  "scripts": {
    "local:dev:api-ai": "yarn workspace @partner-tour-2024/api-ai run dev",
    "local:start:app-ai-dsys-demo": "yarn workspace @partner-tour-2024/app-ai-dsys-demo run start",
    "local:dev:component-definitions": "yarn workspace @contentful-demos/component-definitions run dev",
    "local:server:web-components": "yarn workspace @contentful-demos/web-components run server",
    "local:start:web-components": "yarn workspace @contentful-demos/web-components run start",
    "local:start:web-socket": "yarn workspace web-socket run start",
    "local:start:ctf-web-comps-app": "cd ./otherPackages/contentful-web-components-app && npm run start",
    "local:start:figma-widget-cdef": "cd ./otherPackages/figma-widget-cdef && npm run start",
    "local": "concurrently \"yarn local:dev:api-ai\" \"yarn local:dev:component-definitions\" \"yarn local:start:app-ai-dsys-demo\" \"yarn local:server:web-components\" \"yarn local:start:web-components\" \"yarn local:start:web-socket\""
  },
  "author": "",
