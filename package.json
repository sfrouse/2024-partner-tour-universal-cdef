    "@figma/plugin-typings": "^1.99.0",
    "@figma/widget-typings": "^1.9.1",
    "@types/json-patch": "^0.0.33",
    "lerna": "^8.1.8",
    "type-fest": "^4.26.0"
  },
  "dependencies": {
    "concurrently": "^9.0.1"
  }
}
