{
  "name": "contentful-web-components-app",
  "version": "0.1.0",
  "private": true,
  "proxy": "https://web-components.colorfuldemo.com/",
  "scripts": {
    "start": "cross-env BROWSER=none craco start",
    "build": "craco build",
    "build:tokens": "node ./scripts/tokens/buildTokens.mjs",
    "test": "craco test",
    "eject": "react-scripts eject",
    "create-app-definition": "contentful-app-scripts create-app-definition",
    "upload": "contentful-app-scripts upload --bundle-dir ./build",
    "upload-ci": "dotenv -- cross-var contentful-app-scripts upload --ci --bundle-dir ./build --organization-id %CONTENTFUL_ORG_ID% --definition-id %CONTENTFUL_APP_DEF_ID% --token %CONTENTFUL_ACCESS_TOKEN%",
    "server": "http-server ./dist -p 8081",
    "te": "dotenv cross-var echo %CONTENTFUL_ORG_ID%",
    "yalc:update": "cd ../../packages/component-definitions && yalc publish && cd ../../otherPackages/contentful-web-components-app && yalc update && echo 'done contentful-web-components-app'"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@contentful/app-scripts": "1.13.0",
    "@contentful/live-preview": "^2.11.5",
    "@testing-library/jest-dom": "5.17.0",
    "@testing-library/react": "14.0.0",
    "@tsconfig/create-react-app": "2.0.1",
    "@types/node": "16.18.59",
    "@types/react": "18.2.30",
    "@types/react-dom": "18.2.14",
    "color2k": "^2.0.2",
    "contentful": "^10.6.4",
    "cross-env": "7.0.3",
    "cross-var": "^1.1.0",
    "dotenv-cli": "^7.3.0",
    "http-server": "^14.1.1",
    "prettier": "2.8.8",
    "sass": "^1.69.5",
    "style-dictionary": "^3.9.0",
    "style-dictionary-utils": "^2.0.1",
    "typescript": "4.9.5"
  },
  "dependencies": {
    "@contentful-demos/component-definitions": "file:.yalc/@contentful-demos/component-definitions",
    "@contentful/app-sdk": "^4.23.1",
    "@contentful/f36-components": "4.52.3",
    "@contentful/f36-tokens": "4.0.2",
    "@contentful/react-apps-toolkit": "1.2.16",
    "@craco/craco": "^7.1.0",
    "contentful-management": "10.46.4",
    "emotion": "10.0.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1"
  },
  "homepage": "."
}
