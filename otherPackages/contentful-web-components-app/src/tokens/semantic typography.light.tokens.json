{
  "type": {
    "display": {
      "size": {
        "$type": "dimension",
        "$value": "{type.fontSize.2Xl}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": "{type.lineHeight.2Xl}"
      },
      "weight": {
        "$type": "dimension",
        "$value": "{type.weight.bold}"
      },
      "large": {
        "size": {
          "$type": "dimension",
          "$value": "{type.fontSize.3Xl}"
        },
        "lineHeight": {
          "$type": "dimension",
          "$value": "{type.fontSize.3Xl}"
        },
        "weight": {
          "$type": "dimension",
          "$value": "{type.weight.bold}"
        }
      }
    },
    "heading": {
      "size": {
        "$type": "dimension",
        "$value": "{spacing.Xl}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": "{spacing.Xl}"
      },
      "weight": {
        "$type": "dimension",
        "$value": "{type.weight.bold}"
      }
    },
    "subheading": {
      "size": {
        "$type": "dimension",
        "$value": "{type.fontSize.L}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": "{type.lineHeight.L}"
      },
      "weight": {
        "$type": "dimension",
        "$value": "{type.weight.bold}"
      }
    },
    "body": {
      "size": {
        "$type": "dimension",
        "$value": "{type.fontSize.M}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": "{type.lineHeight.M}"
      },
      "weight": {
        "$type": "dimension",
        "$value": "{type.weight.medium}"
      }
    },
    "sectionHeading": {
      "size": {
        "$type": "dimension",
        "$value": "{type.fontSize.S}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": "{type.lineHeight.Xs}"
      },
      "headingWeight": {
        "$type": "dimension",
        "$value": "{type.weight.demiBold}"
      }
    },
    "fontStack": {
      "primary": {
        "$type": "string",
        "$value": "-apple-system, BlinkMacSystemFont, Segoe UI, Helvetica, Arial, sans-serif, Apple Color Emoji, Segoe UI Emoji, Segoe UI Symbol"
      },
      "monospace": {
        "$type": "string",
        "$value": "SFMono-Regular, Consolas, Liberation Mono, Menlo,monospace"
      }
    }
  }
}