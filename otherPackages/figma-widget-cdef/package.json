{
  "name": "figma-widget-cdef",
  "version": "1.0.0",
  "description": "Figma Widget CDef",
  "type": "module",
  "scripts": {
    "test": "npm run tsc && npm run build",
    "format": "prettier --write .",
    "tsc": "npm run tsc:main && npm run tsc:ui",
    "tsc:main": "tsc --noEmit -p widget-src",
    "tsc:ui": "tsc --noEmit -p ui-src",
    "tsc:watch": "concurrently -n widget,iframe \"npm run tsc:main -- --watch --preserveWatchOutput\" \"npm run tsc:ui -- --watch --preserveWatchOutput\"",
    "build": "npm run build:tokens && npm run build:ui && npm run build:main -- --minify",
    "build:tokens": "node ./scripts/tokens/buildTokens.mjs",
    "build:main": "esbuild widget-src/code.tsx --bundle --outfile=dist/code.js",
    "build:ui": "npx vite build --minify esbuild --emptyOutDir=false",
    "build:watch": "concurrently -n widget,iframe \"npm run build:main -- --watch\" \"npm run build:ui -- --watch\"",
    "dev": "concurrently -n tsc,build,vite 'npm:tsc:watch' 'npm:build:watch' 'vite'",
    "start": "npm run dev",
    "yalc:update": "cd ../../packages/component-definitions && yalc publish && cd ../../otherPackages/figma-widget-cdef && yalc update && echo 'done figma-widget-cdef'"
  },
  "author": "Figma",
  "license": "MIT License",
  "dependencies": {
    "@contentful-demos/component-definitions": "file:.yalc/@contentful-demos/component-definitions",
    "@contentful/f36-forms": "^4.59.3",
    "@contentful/f36-header": "^4.0.0-alpha.1",
    "@contentful/f36-layout": "^4.0.0-alpha.1",
    "@contentful/f36-tokens": "^4.0.4",
    "@lit/react": "^1.0.3",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "style-dictionary": "^3.9.2",
    "style-dictionary-utils": "^2.0.7"
  },
  "devDependencies": {
    "@contentful/f36-components": "^4.59.3",
    "@figma/plugin-typings": "*",
    "@figma/widget-typings": "*",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@vitejs/plugin-react-refresh": "^1.3.1",
    "concurrently": "^6.3.0",
    "contentful": "^10.6.21",
    "contentful-management": "^11.16.0",
    "esbuild": "^0.13.5",
    "prettier": "^2.3.2",
    "sass": "^1.70.0",
    "typescript": "^4.9.5",
    "vite": "^2.5.2",
    "vite-plugin-singlefile": "^0.5.1"
  }
}
